# 07.11 performance: static files were served with max-age=0, so every visit re-checked portraits and scripts.
# 10.11: videos removed; /ai-portraits/* also covers the 160 px thumbnails in /ai-portraits/sm/.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/ai-portraits/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/agents/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/*.png
  Cache-Control: public, max-age=86400
/*.svg
  Cache-Control: public, max-age=86400
/*.jpg
  Cache-Control: public, max-age=86400
