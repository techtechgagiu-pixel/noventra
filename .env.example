# ── Local PostgreSQL / legacy recovery only ─────────────────────
# Live site uses native Cloudflare D1 bindings (wrangler.production.jsonc).
# Live Render runner uses BETMIND_DATABASE=d1-http and the signed bridge.
# Pooled connection string for local PostgreSQL mode.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) connection used only by migrations at startup.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# ── Auth (Google OAuth / OpenID Connect: openid email profile) ────
AUTH_SECRET=generate-at-least-32-random-bytes
# SHA-256 of the normalized permanent admin code (uppercase; spaces/hyphens removed).
OWNER_ACCESS_CODE_HASH=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Owner identity lookup only. Google sessions never receive administrator access.
ADMIN_EMAILS=

# ── AI providers (free tiers) ────────────────────────────────────
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional, not used by default assignments.
OPENROUTER_API_KEY=

# Optional informational schedules from The Odds API (the-odds-api.com).
# Server only; /sports and /events use zero quota credits. ESPN/LPF remain active.
ODDS_API_KEY=

# ── App ──────────────────────────────────────────────────────────
APP_BASE_URL=https://primul11.noventra.ro
APP_TIMEZONE=Europe/Bucharest

# ── Hard limits (app-level caps; providers have their own) ───────
AI_DAILY_CALL_LIMIT=8000
AI_DAILY_TOKEN_LIMIT=20000000
SPORTS_API_DAILY_LIMIT=15000
MAX_CONCURRENT_ANALYSES=2
MAX_FIXTURES_PER_JOB=18
MAX_FIXTURES_WEEKLY_JOB=36
ANALYSIS_BATCH_SIZE=4
DEBATE_ROUNDS=2
CONSENSUS_THRESHOLD=4
ODDS_MAX_AGE_MINUTES=180
TARGET_TOLERANCE=0.15

# Optional: Google redirect URI when it differs from APP_BASE_URL/auth/callback (e.g. an older domain that forwards here)
GOOGLE_REDIRECT_URI=

# Render production runner overrides (set through server environment settings):
# BETMIND_DATABASE=d1-http
# BETMIND_RUNNER_ONLY=1
# BETMIND_MAINTENANCE=0
# BETMIND_DISABLE_WORKER=0
# D1_BRIDGE_URL=https://primul11-app.techguythe0.workers.dev
# D1_BRIDGE_SECRET=<same server-only secret as the production Worker>
# Cloudflare Worker secret (existing Render runner, no additional service):
# ANALYSIS_RUNNER_URL=https://betmind-nexus.onrender.com
