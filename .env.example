# ── Database (Neon PostgreSQL Free) ──────────────────────────────
# Pooled connection string used by the app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) connection used only by migrations at startup.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# ── Auth (Google OAuth / OpenID Connect: openid email profile) ────
AUTH_SECRET=generate-at-least-32-random-bytes
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated e-mails that get the administrator role at login.
ADMIN_EMAILS=

# ── AI providers (free tiers) ────────────────────────────────────
GROQ_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional, not used by default assignments.
OPENROUTER_API_KEY=

# ── Optional odds provider (The Odds API). ESPN is the default source.
ODDS_API_KEY=

# ── App ──────────────────────────────────────────────────────────
APP_BASE_URL=https://nexus.noventra.ro
APP_TIMEZONE=Europe/Bucharest

# ── Hard limits (app-level caps; providers have their own) ───────
AI_DAILY_CALL_LIMIT=3000
AI_DAILY_TOKEN_LIMIT=6000000
SPORTS_API_DAILY_LIMIT=6000
MAX_CONCURRENT_ANALYSES=2
MAX_FIXTURES_PER_JOB=18
MAX_FIXTURES_WEEKLY_JOB=36
ANALYSIS_BATCH_SIZE=3
DEBATE_ROUNDS=2
CONSENSUS_THRESHOLD=4
ODDS_MAX_AGE_MINUTES=180
TARGET_TOLERANCE=0.15
