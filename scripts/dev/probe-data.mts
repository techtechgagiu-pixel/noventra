import { loadFixtures } from '../../src/lib/sports/fixtures';
import { teamHistory } from '../../src/lib/scout/history';
import { buildDossier } from '../../src/lib/scout/dossier';
import { modelFixture } from '../../src/lib/stats/engine';
import { localDate } from '../../src/lib/time';
import { closePool } from '../../src/lib/db';
const t0 = Date.now();
const { fixtures, errors } = await loadFixtures(localDate(), 5);
console.log('fixtures', fixtures.length, 'withOdds', fixtures.filter((f) => f.odds).length, 'errors', errors, 'ms', Date.now() - t0);
const byLeague: Record<string, number> = {}; for (const f of fixtures) byLeague[f.leagueId] = (byLeague[f.leagueId] ?? 0) + 1; console.log(byLeague);
const f = fixtures.find((x) => x.odds && x.status === 'pre' && x.leagueId === 'ENG1')!;
console.log(f.home, f.away, f.kickoff, f.odds);
const [h, a] = await Promise.all([teamHistory(f, 'home'), teamHistory(f, 'away')]);
console.log('history', h.matches.length, a.matches.length, h.missing, h.matches[0]);
const d = buildDossier({ home: f.home, away: f.away, kickoff: f.kickoff, league: f.leagueName, homeMatches: h.matches, awayMatches: a.matches, missing: [] });
console.log(JSON.stringify(d.home, null, 1).slice(0, 1500));
const m = modelFixture({ homeHistory: h.matches, awayHistory: a.matches, markets: f.odds!.markets });
console.log(JSON.stringify(m, null, 1));
console.log('total ms', Date.now() - t0);
await closePool();
