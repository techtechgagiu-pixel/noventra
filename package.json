{
  "name": "betmind-six",
  "version": "5.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "node scripts/start.mjs",
    "migrate": "node scripts/migrate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cf:build": "node scripts/cloudflare/build.mjs",
    "cf:preview": "wrangler dev --port 8787",
    "cf:types": "wrangler types cloudflare/worker-configuration.d.ts --include-runtime=false",
    "cf:export": "node scripts/cloudflare/export-postgres.mjs",
    "cf:audit": "node scripts/cloudflare/audit.mjs",
    "cf:test-conversion": "python3 tests/cloudflare_conversion_test.py",
    "cf:typecheck": "tsc -p cloudflare/tsconfig.json",
    "cf:deploy": "node scripts/cloudflare/audit.mjs --require-ready && wrangler deploy",
    "cf:smoke": "node scripts/cloudflare/smoke-preview.mjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "motion": "12.23.0",
    "next": "16.4.2",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261025.1",
    "@opennextjs/cloudflare": "1.20.13",
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.18.0",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "tailwindcss": "4.1.13",
    "tsx": "^4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.7",
    "wrangler": "4.152.0"
  },
  "type": "module",
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    },
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
