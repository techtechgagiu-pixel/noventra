{
  "$schema":"node_modules/wrangler/config-schema.json",
  "name":"primul11-app",
  "account_id":"098f56d02919a4483e25f22cd111e7a3",
  "main":"cloudflare/staging-worker.ts",
  "compatibility_date":"2026-10-25",
  "compatibility_flags":["nodejs_compat","global_fetch_strictly_public"],
  "workers_dev":true,
  "preview_urls":false,
  "routes":[{"pattern":"primul11.noventra.ro","custom_domain":true,"zone_id":"41a96fd65b90bad4363d703974490317"}],
  "assets":{"directory":".open-next/assets","binding":"ASSETS"},
  "d1_databases":[{"binding":"DB","database_name":"primul11-production-20261026","database_id":"8ec1fe52-2f39-46d4-9c8b-22271a5c3d4a","migrations_dir":"cloudflare/d1/migrations"}],
  "workflows":[{"binding":"SETTLEMENT","name":"primul11-results","class_name":"SettlementWorkflow"}],
  "triggers":{"crons":["*/5 * * * *"]},
  "limits":{"cpu_ms":3000},
  "ratelimits":[
    {"name":"RL_LOGIN_ALL","namespace_id":"1101","simple":{"limit":100,"period":60}},
    {"name":"RL_LOGIN","namespace_id":"1102","simple":{"limit":10,"period":60}},
    {"name":"RL_ASSISTANT","namespace_id":"1103","simple":{"limit":12,"period":60}},
    {"name":"RL_CUSTOM","namespace_id":"1104","simple":{"limit":6,"period":60}},
    {"name":"RL_CHECKOUT","namespace_id":"1105","simple":{"limit":5,"period":60}}
  ],
  "observability":{"enabled":true,"head_sampling_rate":0.1},
  "vars":{"BETMIND_RUNTIME":"cloudflare-production","BETMIND_DATABASE":"d1","BETMIND_DISABLE_WORKER":"1","BETMIND_MAINTENANCE":"0","APP_TIMEZONE":"Europe/Bucharest","SPORTS_API_DAILY_LIMIT":"30000","ODDS_API_CORNERS_CARDS":"1","MAX_CONCURRENT_ANALYSES":"3","CREDITS_ENABLED":"1"}
}
